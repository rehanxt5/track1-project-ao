# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# GATEWAY_MODE controls how metaagent.gateway talks to providers:
#   live   - make real HTTP calls (default when unset)
#   fake   - deterministic offline responses, no network, no keys required
#   record - make real calls and save request/response fixtures to disk
#   replay - serve saved fixtures instead of making real calls
GATEWAY_MODE=fake

# layer "meta" = the strong brain (architect / failure-analyzer / optimizer)
META_BASE_URL=https://api.openai.com/v1
META_API_KEY=sk-placeholder
META_MODEL=gpt-4o

# layer "worker" = the cheap hands (generated agents doing tasks)
WORKER_BASE_URL=https://api.tensormux.com/v1
WORKER_API_KEY=tmx_placeholder
WORKER_MODEL=glm-4-7-flash

# Fallback provider used when the primary layer's provider errors out
# (429 / 5xx / timeout) after exhausting retries.
FALLBACK_BASE_URL=https://api.tensormux.com/v1
FALLBACK_API_KEY=tmx_placeholder
FALLBACK_MODEL=glm-4-7-flash
